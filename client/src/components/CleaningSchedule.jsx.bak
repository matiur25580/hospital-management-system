import { useEffect, useState } from 'react';
import api from '../api';
import { useLang } from '../i18n/LanguageContext.jsx';
const DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
function monday() { const d = new Date(); const day = (d.getDay() + 6) % 7; d.setDate(d.getDate() - day); return d.toISOString().slice(0, 10); }
function addDays(iso, n) { const d = new Date(iso); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); }
export default function CleaningSchedule({ mode = 'view' }) {
  const { t } = useLang();
  const [sched, setSched] = useState([]);
  const [logs, setLogs] = useState([]);
  const [tab, setTab] = useState('today');
  const ws = monday();
  const todayStr = new Date().toISOString().slice(0, 10);
  const todayIdx = DAYS.indexOf(['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][new Date().getDay()]);
  const todayName = DAYS[todayIdx];
  const load = async () => {
    try {
      const s = await api.get('/cleaning/schedule');
      const l = await api.get('/cleaning/logs?from=' + ws + '&to=' + addDays(ws, 6));
      setSched(s.data || []); setLogs(l.data || []);
    } catch (e) { console.error(e); }
  };
  useEffect(() => { load(); }, []);
  const isDone = (date, e) => logs.some(l => l.date === date && l.zone === e.zone && l.task === e.task && l.shift === e.shift);
  const markDone = async (date, e) => { await api.post('/cleaning/log', { date, zone: e.zone, task: e.task, shift: e.shift, assignedTo: e.assignedTo }); load(); };
  const tk = k => t('cl.t_' + k), zk = z => t('cl.z_' + z), sk = s => t('cl.s_' + s), dk = d => t('cl.d_' + d.toLowerCase());
  let total = 0, done = 0;
  DAYS.forEach((d, i) => { if (i > todayIdx) return; sched.forEach(e => { if (e.days.includes(d)) { total++; if (isDone(addDays(ws, i), e)) done++; } }); });
  const pct = total ? Math.round(done / total * 100) : 0;
  const todayTasks = sched.filter(e => e.days.includes(todayName));
  const tabBtn = active => ({ padding: '6px 14px', borderRadius: 6, border: '1px solid #ccc', background: active ? '#1976d2' : '#fff', color: active ? '#fff' : '#333', cursor: 'pointer' });
  return (
    <div style={{ border: '1px solid #ddd', borderRadius: 10, padding: 14, margin: '12px 0', background: '#fff' }}>
      <h3>🧹 {t('cl.title')}</h3>
      <div style={{ display: 'flex', gap: 8, marginBottom: 10, alignItems: 'center', flexWrap: 'wrap' }}>
        <button onClick={() => setTab('today')} style={tabBtn(tab === 'today')}>{t('cl.today')}</button>
        <button onClick={() => setTab('week')} style={tabBtn(tab === 'week')}>{t('cl.week')}</button>
        <span style={{ marginLeft: 'auto', fontSize: 13 }}>{t('cl.week_done')}: <b>{done}/{total} ({pct}%)</b></span>
      </div>
      {tab === 'today' ? (
        <div>
          {todayTasks.map((e, i) => {
            const d = isDone(todayStr, e);
            return (
              <div key={i} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '8px 4px', borderBottom: '1px solid #f0f0f0', fontSize: 13 }}>
                <span><b>{e.time}</b> · {zk(e.zone)} · {tk(e.task)} <small style={{ color: '#888' }}>({sk(e.shift)} · {e.assignedTo})</small></span>
                {d ? <span style={{ color: '#2e7d32', fontWeight: 'bold' }}>✅ {t('cl.done')}</span>
                  : mode === 'admin'
                    ? <button onClick={() => markDone(todayStr, e)} style={{ padding: '4px 12px', background: '#2e7d32', color: '#fff', border: 'none', borderRadius: 5, cursor: 'pointer' }}>{t('cl.mark_done')}</button>
                    : <span style={{ color: '#999' }}>{t('cl.pending')}</span>}
              </div>
            );
          })}
          {todayTasks.length === 0 && <div style={{ color: '#999', fontSize: 13 }}>{t('cl.no_task')}</div>}
        </div>
      ) : (
        <div style={{ overflowX: 'auto' }}>
          <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 12 }}>
            <thead><tr style={{ background: '#f5f5f5' }}>
              {[t('cl.day'), t('cl.time'), t('cl.zone'), t('cl.task'), t('cl.shift'), t('cl.assigned'), t('cl.status')].map((h, i) => <th key={i} style={{ padding: 6, textAlign: 'left', borderBottom: '2px solid #ddd' }}>{h}</th>)}
            </tr></thead>
            <tbody>
              {DAYS.map((d, di) => sched.filter(e => e.days.includes(d)).map((e, i) => {
                const dt = addDays(ws, di); const past = di <= todayIdx; const dn = past && isDone(dt, e);
                return (
                  <tr key={d + i} style={{ borderBottom: '1px solid #f0f0f0', opacity: past ? 1 : 0.5 }}>
                    <td style={{ padding: 6, fontWeight: 'bold' }}>{dk(d)}</td>
                    <td style={{ padding: 6 }}>{e.time}</td>
                    <td style={{ padding: 6 }}>{zk(e.zone)}</td>
                    <td style={{ padding: 6 }}>{tk(e.task)}</td>
                    <td style={{ padding: 6 }}>{sk(e.shift)}</td>
                    <td style={{ padding: 6 }}>{e.assignedTo}</td>
                    <td style={{ padding: 6 }}>{!past ? '—' : dn ? <span style={{ color: '#2e7d32' }}>✅ {t('cl.done')}</span> : <span style={{ color: '#999' }}>{t('cl.pending')}</span>}</td>
                  </tr>
                );
              }))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
